            </div>
          </div>

          <!-- KONTAKT -->
          <div class="legal-row">
            <div class="legal-label">Kontakt</div>
            <div class="legal-entries">
              <p>
                E-Mail: <a href="mailto:Ricardo.Mehl@gmx.de">Ricardo.Mehl@gmx.de</a><br />
                Telefon: +49 (0) 151 64723954
              </p>
            </div>
          </div>

          <!-- REDAKTIONELL VERANTWORTLICH -->
          <div class="legal-row">
            <div class="legal-label">Redaktionell verantwortlich</div>
            <div class="legal-entries">
              <p>
                Ricardo Mehl<br />
                Gewendeweg 64<br />
                90765 Fürth
              </p>
            </div>
          </div>

          <!-- VERBRAUCHERSTREITBEILEGUNG -->
