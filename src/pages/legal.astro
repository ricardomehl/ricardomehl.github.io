<style>
  /* ====================================================== */
  /* 1. LAYOUT & GRID STRUCTURE                             */
  /* ====================================================== */


    .projects-layout {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    column-gap: 2.5rem;
    align-items: start;
  }

   /* TAG FILTER PLACEHOLDER GRID POSITION */
  .tag-filter-wrapper {
    grid-column: 2;
    grid-row: 1;
    margin-bottom: 1rem;
  }

    /* Platzhalter unsichtbar lassen, damit er Platz reserviert */
  .tag-filter-wrapper.placeholder {
    visibility: hidden;
    min-height: 30.2px; /* Tags höhe in pxiel */
  }

   /* SIDEBAR GRID POSITION */
  .sidebar-wrapper {
    grid-column: 1;
    grid-row: 2;
    padding-top: 1rem;
    /* Sticky Verhalten */
    position: sticky;
    top: 0.5rem;
    z-index: 10; /* Verhindert, dass Bilder beim Scrollen den Filter überlagern */
  }

  .about-content {
    grid-column: 2;
    grid-row: 2;
    width: 100%;
    padding-top: 1rem;
  }

  /* ====================================================== */
  /* 2. IMPRESSUM CONTENT GRID (2 Spalten: Label + Content) */
  /* ====================================================== */

  .legal-grid-container {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem 2.5rem; 
    width: 100%;
    max-width: 900px; /* Liest sich bei langem Rechtstext angenehmer */
  }

  .legal-table,
  .legal-row {
    display: contents;
  }

  /* Spalte 1: Beschriftungen links */
  .legal-label {
    grid-column: 1;
    font-weight: 500;
    opacity: 0.8;
    margin-bottom: 2.5rem;
  }

  /* Spalte 2: Rechtstexte rechts */
  .legal-entries {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .legal-entries p {
    margin: 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  .legal-entries a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-entries .source {
    font-size: 0.85rem;
    opacity: 0.6;
    margin-top: 0.5rem;
  }

  /* ====================================================== */
  /* 3. RESPONSIVE DESIGN (Tablets & Mobile)                */
  /* ====================================================== */

  @media (max-width: 900px) {
    .projects-layout {
      grid-template-columns: 1fr;
    }

    .about-content {
      grid-column: 1;
    }

    .legal-grid-container {
      grid-template-columns: 140px 1fr;
    }
  }

  @media (max-width: 768px) {
    .legal-grid-container {
      grid-template-columns: 1fr;
    }

    .legal-label,
    .legal-entries {
      grid-column: 1;
    }

    .legal-label {
      margin-bottom: 0.5rem;
    }
  }
</style>