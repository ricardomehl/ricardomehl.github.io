---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { sanityClient } from 'sanity:client';

interface Project {
  _id: string;
  title: string;
  slug: { current: string };
  tags?: string[];
  imageUrl?: string;
  date?: string;
}

// Wir holen die Projekte, damit die Sidebar konsistent bleibt
const { projects } = await sanityClient.fetch<{ projects: Project[] }>(`
  {
    "projects": *[_type == "project"] | order(date desc, _createdAt desc) {
      _id,
      title,
      slug,
      tags,
      "imageUrl": mainImage.asset->url,
      "date": date
    }
  }
`);
---

<Layout title="Impressum — Ricardo Mehl">
  <div class="projects-layout">
  

    <!-- Platzhalter für Tag-Filter (reserviert exakt denselben Platz auf Desktop) -->
    <div class="tag-filter-wrapper placeholder" aria-hidden="true"></div>


    <aside class="sidebar-wrapper">
      <Sidebar projects={projects} transition:persist="main-sidebar" />
    </aside>


    <div class="about-content">

      <!-- Dieser Anker markiert exakt die Oberkante, an der festgeklemmt werden soll -->
