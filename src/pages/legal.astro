              <p>
                Ricardo Mehl<br />
                Gewendeweg 63<br />
                90765 Fürth<br />
                Deutschland
              </p>
            </div>
          </div>

          <!-- KONTAKT -->
          <div class="legal-row">
            <div class="legal-label">Contact</div>
            <div class="legal-entries">
              <p>
                E-Mail: <a href="mailto:ricardomehl@proton.me">ricardomehl@proton.me</a><br />
                Phone: +49 (0) 151 64723954
              </p>
            </div>
          </div>

          <!-- REDAKTIONELL VERANTWORTLICH -->
