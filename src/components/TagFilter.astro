---
interface Props {
  tags: string[];
}

const { tags = [] } = Astro.props;
---

<section class="tag-filter-container">
  <button class="tag-chip active" data-filter="all">Alle</button>
  {tags.map((tag) => (
    <button class="tag-chip" data-filter={tag}>{tag}</button>
  ))}
</section>

<!-- Client-seitige Filterlogik -->
<script>
  function initTagFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
    const projectTextItems = document.querySelectorAll<HTMLElement>('.project-text-item');

    if (filterButtons.length === 0) return;

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedFilter = button.getAttribute('data-filter');

        // Active state auf Buttons umschalten
        filterButtons.forEach((btn) => btn.classList.remove('active'));
        button.classList.add('active');

        // Bildkacheln filtern
        projectCards.forEach((card) => {
          const cardTags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');
          card.style.display = (selectedFilter === 'all' || cardTags.includes(selectedFilter!)) ? 'flex' : 'none';
        });

        // Textliste in der Sidebar filtern
        projectTextItems.forEach((item) => {
          const itemTags: string[] = JSON.parse(item.getAttribute('data-tags') || '[]');
          item.style.display = (selectedFilter === 'all' || itemTags.includes(selectedFilter!)) ? 'block' : 'none';
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initTagFilter);
</script>

<style>
  /* ====================================================== */
  /* 1. CONTAINER (Anordnung der Inhalte IN der Komponente) */
  /* ====================================================== */
  .tag-filter-container {
    /* Flexbox sorgt dafür, dass die Chips nebeneinander liegen und umbrechen */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem; /* Abstand ZWISCHEN den einzelnen Chips */
  }

  /* Platzhalter-Zustand für Seiten ohne Tags */
  .tag-filter-container.placeholder {
    visibility: hidden;
    min-height: 2.25rem; /* Hält die Höhe eines Tag-Chips aufrecht */
  }

  /* ====================================================== */
  /* 2. CHIP STYLING (Optik der einzelnen Buttons)          */
  /* ====================================================== */
  .tag-chip {
    background: var(--bg-color, #fff);
    color: var(--text-color, #000);
    border: 1px solid var(--border-color, #ccc);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-chip:hover,
  .tag-chip.active {
    background-color: var(--text-color, #000);
    color: var(--bg-color, #fff);
    border-color: var(--text-color, #000);
  }
</style>