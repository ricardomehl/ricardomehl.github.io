---
interface ProjectListItem {
  _id: string;
  title: string;
  slug: { current: string };
  tags?: string[];
}

interface Props {
  projects: ProjectListItem[];
  activeSlug?: string;
}

const { projects = [], activeSlug } = Astro.props;
---



<aside class="projects-list-sidebar">
  <ul class="projects-text-list">
    {projects.map((project) => {
      const isActive = project.slug.current === activeSlug;
      return (
        <li 
          class={`project-text-item ${isActive ? 'is-active' : ''}`} 
          data-tags={JSON.stringify(project.tags || [])}
        >
          <a href={`/project/${project.slug.current}`}>
            {project.title}
          </a>
        </li>
      );
    })}
  </ul>
</aside>


<style>
  .projects-list-sidebar {
    grid-column: 1;
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .projects-text-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem; 
  }

  .project-text-item a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.2s ease;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .project-text-item a:hover,
  .project-text-item.is-active a {
    opacity: 1;
  }




/* ====================================================== */
/* 3. RESPONSIVE BREAKPOINTS                              */
/* ====================================================== */

/* Sidebar verschwindet bei Mobile */
@media (max-width: 900px) {
    
  .projects-list-sidebar{
    display: none !important;
  }
}


</style>



